[
  {
    "name": "Backend",
    "match": ["backend/**"],
    "children": [
      { "name": "Tests", "match": ["backend/tests/**"] },
      { "name": "Source", "fallback": true }
    ]
  },
  {
    "name": "Extension",
    "match": ["extension/**"],
    "children": [
      { "name": "Tests", "match": ["extension/tests/**"] },
      { "name": "Third-party", "match": ["extension/third_party/**"] },
      { "name": "Source", "fallback": true }
    ]
  },
  { "name": "Browser tests", "match": ["tests/**"] },
  { "name": "Docs", "match": ["docs/**", "**/*.md"] },
  { "name": "Dependencies", "match": ["pyproject.toml", "uv.lock"] },
  { "name": "CI", "match": [".github/**"] },
  { "name": "Tooling", "match": ["scripts/**", "*.sh"] }
]
